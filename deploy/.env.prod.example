# Copie para deploy/.env e preencha. Nunca commite o .env.
POSTGRES_DB=pedeai
POSTGRES_USER=pedeai
# Gere com: openssl rand -base64 32
POSTGRES_PASSWORD=
# Pelo menos 32 caracteres. Gere com: openssl rand -base64 48
JWT_SECRET=
# Domínio da API, apontando (registro A) para o IP do servidor. Ex.: api.seudominio.com.br
API_DOMAIN=
# Endereço do app na Vercel. Ex.: https://pedeai.vercel.app
APP_CORS_ALLOWED_ORIGINS=
# Cadastro de lojas pela tela: deixe false e crie as lojas do piloto você mesmo.
SIGNUP_ENABLED=false
IFOOD_ENABLED=false
IFOOD_CLIENT_ID=
IFOOD_CLIENT_SECRET=
# 99Food pelo padrão Open Delivery: URL da API e credenciais que a 99Food passa à integradora; APP_ID é o X-App-Id do webhook.
NINETYNINE_BASE_URL=
NINETYNINE_CLIENT_ID=
NINETYNINE_CLIENT_SECRET=
NINETYNINE_APP_ID=
# Outro app no padrão Open Delivery (opcional).
OPENDELIVERY_APP_NAME=
OPENDELIVERY_BASE_URL=
OPENDELIVERY_CLIENT_ID=
OPENDELIVERY_CLIENT_SECRET=
OPENDELIVERY_APP_ID=
SENTRY_DSN=
