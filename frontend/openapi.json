  "components": {
    "schemas": {
      "SectorRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 60,
            "minLength": 0
          },
          "defaultSector": {
            "type": "boolean"
          },
          "active": {
            "type": "boolean"
          }
        },
        "required": [
          "active",
          "defaultSector",
          "name"
        ]
      },
      "SectorResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "defaultSector": {
            "type": "boolean"
          },
          "active": {
            "type": "boolean"
          }
        },
        "required": [
          "active",
          "defaultSector",
          "id",
          "name"
        ]
      },
      "ProductRequest": {
        "type": "object",
        "properties": {
          "categoryId": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string",
            "maxLength": 40,
            "minLength": 0
          },
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 0
          },
          "description": {
            "type": "string",
            "maxLength": 500,
            "minLength": 0
          },
          "priceCents": {
            "type": "integer",
            "format": "int64",
            "maximum": 10000000,
            "minimum": 0
          },
          "sectorId": {
            "type": "string",
            "format": "uuid"
          },
          "optionGroupIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "maxItems": 20,
            "minItems": 0
          },
          "available": {
            "type": "boolean"
          },
          "active": {
            "type": "boolean"
          }
        },
        "required": [
          "active",
          "available",
          "categoryId",
          "name",
          "optionGroupIds",
          "priceCents"
        ]
      },
      "ProductResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "categoryId": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "priceCents": {
            "type": "integer",
            "format": "int64"
          },
          "sectorId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "effectiveSectorId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "optionGroupIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "available": {
            "type": "boolean"
          },
          "active": {
            "type": "boolean"
          }
        },
        "required": [
          "active",
          "available",
          "categoryId",
          "code",
          "description",
          "effectiveSectorId",
          "id",
          "name",
          "optionGroupIds",
          "priceCents",
          "sectorId"
        ]
      },
      "AvailabilityRequest": {
        "type": "object",
        "properties": {
          "available": {
            "type": "boolean"
          }
        },
        "required": [
          "available"
        ]
      },
      "OptionGroupRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 0
          },
          "minChoices": {
            "type": "integer",
            "format": "int32",
            "maximum": 50,
            "minimum": 0
          },
          "maxChoices": {
            "type": "integer",
            "format": "int32",
            "maximum": 50,
            "minimum": 1
          },
          "pricingRule": {
            "type": "string",
            "enum": [
              "SUM",
              "MAX",
              "AVERAGE"
            ]
          },
          "active": {
            "type": "boolean"
          },
          "options": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OptionItemRequest"
            },
            "maxItems": 100,
            "minItems": 0
          }
