# Copie para .env (que não vai para o Git) e ajuste os valores.
# Usado pelo docker compose e pela API rodando localmente (./mvnw spring-boot:run).

# PostgreSQL local
POSTGRES_DB=pedeai
POSTGRES_USER=pedeai
POSTGRES_PASSWORD=troque-esta-senha

# API
DB_URL=jdbc:postgresql://localhost:5432/pedeai
DB_USERNAME=pedeai
DB_PASSWORD=troque-esta-senha
# Pelo menos 32 caracteres. Gere um com: openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-longo-com-pelo-menos-32-caracteres
# Em produção (HTTPS) fica true. Em http://localhost precisa ser false.
REFRESH_COOKIE_SECURE=false
SIGNUP_ENABLED=true
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
# iFood (aplicativo centralizado do iFood Developer). Sem credenciais, a integração fica desligada.
IFOOD_ENABLED=false
IFOOD_CLIENT_ID=
IFOOD_CLIENT_SECRET=
# true libera "Simular pedido do iFood" na tela de integrações (desenvolvimento e demonstração).
IFOOD_SIMULATOR=false
# Pedidos simulados da 99Food e de outro app Open Delivery, sem credenciais.
OPENDELIVERY_SIMULATOR=false
# Fotos dos produtos no Cloudflare R2 (docs/07-deploy.md#fotos-dos-produtos). Sem elas, as fotos ficam desligadas.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
# Alerta de erro em produção (sentry.io). Sem DSN, fica desligado.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
