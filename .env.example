# Copie para .env (que não vai para o Git) e ajuste os valores.
# Usado pelo docker compose e pela API rodando localmente (./mvnw spring-boot:run).

# PostgreSQL local
POSTGRES_DB=pedeai
POSTGRES_USER=pedeai
POSTGRES_PASSWORD=troque-esta-senha

# API
DB_URL=jdbc:postgresql://localhost:5432/pedeai
DB_USERNAME=pedeai
DB_PASSWORD=troque-esta-senha
# Pelo menos 32 caracteres. Gere um com: openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-longo-com-pelo-menos-32-caracteres
# Em produção (HTTPS) fica true. Em http://localhost precisa ser false.
REFRESH_COOKIE_SECURE=false
SIGNUP_ENABLED=true
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
